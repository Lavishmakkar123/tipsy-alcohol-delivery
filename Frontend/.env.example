# OAuth client ID from the Google Cloud Console (APIs & Services > Credentials).
# Required for the "Sign in with Google" button. Without it, the button
# renders in a disabled state. Free to create.
VITE_GOOGLE_CLIENT_ID=

# App ID from a Facebook app at developers.facebook.com (Settings > Basic).
# Required for the "Sign in with Facebook" button. Free to create, but a
# production app (real users, not just your own test accounts) needs Meta's
# app review for the email permission. Without it, the button renders in a
# disabled state.
VITE_FACEBOOK_APP_ID=

# "Sign in with Apple" is not wired up. It requires a paid Apple Developer
# Program membership (US$99/year) — there is no free tier, so it's left out
# until you have one.

# Where the Backend API is running. Defaults to localhost:5000 if unset.
VITE_API_URL=http://localhost:5000

# Stripe publishable key (test mode), from https://dashboard.stripe.com/test/apikeys.
# Free — test mode never charges real money. Required for the checkout page;
# without it, checkout shows a "payments not configured" message.
VITE_STRIPE_PUBLISHABLE_KEY=
