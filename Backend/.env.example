# If using the bundled docker-compose.yml (`docker compose up -d`), DB_HOST
# is 127.0.0.1, DB_USER is root, and DB_PASSWORD is whatever you set here —
# docker-compose reads this same file and uses DB_PASSWORD as the MySQL root
# password on first container start.
# Exact origin the Frontend runs at — CORS only allows requests from here.
FRONTEND_URL=http://localhost:5173

PORT=5000
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=alcohol_delivery

# Stripe secret key (test mode), from https://dashboard.stripe.com/test/apikeys.
# Free — test mode never charges real money. Required for checkout's
# payment-intent endpoint to work; without it, that endpoint returns a 500.
STRIPE_SECRET_KEY=

# Signing secret for JWTs issued on login/register. Any long random string —
# generate one with `openssl rand -hex 32`. Changing it invalidates every
# token already issued (everyone gets logged out).
JWT_SECRET=
